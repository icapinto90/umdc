{
  "name": "umdc-site",
  "version": "2.0.0",
  "description": "Site UMDC — Un Monde De Chalance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,vite -c gray,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "libphonenumber-js": "^1.13.15",
    "multer": "^2.4.0",
    "three": "0.149.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "vite": "^6.4.4"
  }
}
